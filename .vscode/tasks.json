{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Update SIMBIOZ addons and Database",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/update_simbioz_repo.sh",
      "options": {
        "cwd": "${workspaceFolder}/simbioz_repo"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": true,
        "clear": true
      }
    },
    {
      "label": "Update Database only",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/update_database.sh",
      "options": {
        "cwd": "${workspaceFolder}/simbioz_repo"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": true,
        "clear": true
      }
    },
    {
      "label": "Backup Database",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "click-odoo-backupdb -c config_local/odoo-server.conf ${input:databaseName} ${workspaceFolder}/db_backup/prod_$(date +'%d_%m_%Y_%H_%M').zip"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Restore Database",
      "type": "shell",
      "command": "click-odoo-restoredb",
      "args": [
        "-c",
        "config_local/odoo-server.conf",
        "--force",
        "${input:databaseName}",
        "${input:databaseBackup}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Run Tests for Addons",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/run_tests.sh",
      "args": ["${input:dropDatabase}", "tests"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": true,
        "clear": true
      },
      "options": {
        "cwd": "${workspaceFolder}/simbioz_repo"
      }
    }
  ],
  "inputs": [
    {
      "id": "dropDatabase",
      "type": "pickString",
      "description": "Drop database before runnig tests",
      "options": ["yes", "no"],
      "default": "yes"
    },
    {
      "id": "databaseName",
      "type": "promptString",
      "description": "Database Name",
      "default": "prod"
    },
    {
      "id": "databaseBackup",
      "type": "promptString",
      "description": "Backup file",
      "default": ""
    }
  ]
}
